# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored - never commit real values.
# ---------------------------------------------------------------------------

# --- AWS ---
AWS_REGION=ap-south-1
AWS_PROFILE=default
# Globally unique. Change <yourname>.
S3_BUCKET=zerodownpipeline-data-yourname

# --- EC2 (filled in by infra/provision.py -> infra/outputs.json) ---
EC2_KEY_NAME=zerodownpipeline-key
EC2_KEY_PATH=./zerodownpipeline-key.pem
EC2_INSTANCE_TYPE=t3.micro
EC2_HOST=

# --- Docker Hub ---
DOCKERHUB_USER=yourdockerhubuser
DOCKER_IMAGE=zerodownpipeline-api

# --- MySQL ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=zerodown
MYSQL_USER=zerodown
MYSQL_PASSWORD=change-me-app
MYSQL_REPL_USER=repl
MYSQL_REPL_PASSWORD=change-me-repl

# Host-side ports for local testing only. Leave these alone on EC2. Change them
# if your machine already runs MySQL or Redis - the containers are unaffected,
# they always talk to each other on the default ports over the zdp-net network.
MYSQL_PRIMARY_HOST_PORT=3306
MYSQL_REPLICA_HOST_PORT=3307
REDIS_HOST_PORT=6379

# --- App runtime ---
APP_PORT_BLUE=8000
APP_PORT_GREEN=8001
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL_SECONDS=300
